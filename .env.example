# Semantic Terminology Matcher Configuration
# Copy this file to .env and update values as needed

# Qdrant settings
STM_QDRANT_HOST=localhost
STM_QDRANT_PORT=6333
STM_QDRANT_COLLECTION=terminology
STM_QDRANT_USE_MEMORY=false

# Embedding model (default: sentence-transformers/all-MiniLM-L6-v2)
STM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
STM_EMBEDDING_DIM=384

# API settings
STM_API_HOST=0.0.0.0
STM_API_PORT=8000
